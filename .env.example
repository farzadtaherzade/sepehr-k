# Copy this file to .env and adjust values.
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=evm_admin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=evm_db
# Host port for PostgreSQL (5432 is taken by a local Windows PostgreSQL service,
# so we default to 5433. Inside the Docker network it is always 5432.)
POSTGRES_HOST_PORT=5433

# --- Directus ---
DIRECTUS_HOST_PORT=8080
# Public URL used by Directus for links (email invites, shared views)
PUBLIC_URL=http://localhost:8080
# First-run admin account (Directus creates this user on first boot)
DIRECTUS_ADMIN_EMAIL=admin@evm.local
DIRECTUS_ADMIN_PASSWORD=change_me_admin_password
# Generate BOTH with: openssl rand -hex 32
# KEY identifies the Directus instance; SECRET signs sessions/tokens.
# Changing SECRET invalidates all existing login sessions.
DIRECTUS_KEY=please_change_this_directus_key
DIRECTUS_SECRET=please_change_this_directus_secret

# --- Backup service (runs inside postgres:16-alpine, no extra image) ---
BACKUP_HOUR=2              # 02:00 local container time (TZ below)
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_WEEKS=8
BACKUP_KEEP_MONTHS=6
TZ=Asia/Tehran             # affects backup schedule timestamp

# --- Web App (evm-webapp) ---
WEBAPP_HOST_PORT=3600
# Signs login session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET=please_change_this_64_hex_secret
# Least-privilege DB role used by the web app at runtime (created/synced at startup)
EVM_APP_PASSWORD=please_change_this_app_password
# Set true ONLY when serving the app over HTTPS
COOKIE_SECURE=false
# First admin account — created on first startup only (password change forced at first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
